    "post_date": "2026-04-24",
    "date_source": "content_roc",
    "month_label": "五月",
    "day": "08",
    "link": "https://sdgs.fgu.edu.tw/zh_tw/announcement/News/-%E5%9F%B9%E5%8A%9B%E8%AC%9B%E5%BA%A7-%E8%A8%88%E7%95%AB%E7%B8%BE%E6%95%88%E7%BF%BB%E8%BD%89-%E5%BE%9E-KPI-%E9%82%81%E5%90%91-SROI-%E5%AF%A6%E6%88%B0%E8%A7%A3%E6%9E%90-12168613",
